#!/usr/bin/env python3
"""TileIt Settings — Magnet-style preferences for the TileIt KWin script.

Shortcuts live in KDE's global shortcut daemon (kglobalaccel) under the
"kwin" component, so changes here show up in System Settings and vice versa.
"""

import subprocess
import sys

import dbus
from PyQt6.QtCore import QKeyCombination, QRectF, Qt, QTimer
from PyQt6.QtGui import QColor, QIcon, QKeySequence, QPainter, QPalette, QPixmap
from PyQt6.QtWidgets import (
    QApplication, QFormLayout, QFrame, QGridLayout, QHBoxLayout, QKeySequenceEdit,
    QLabel, QMessageBox, QPushButton, QScrollArea, QSpinBox, QToolButton,
    QVBoxLayout, QWidget,
)

COMPONENT = "kwin"
COMPONENT_NAME = "KWin"
PREFIX = "TileIt: "
SCRIPT_GROUP = "Script-tileit"

# (section, [(action, layout fractions x, y, w, h or None)]) — keep in sync
# with LAYOUTS in kwin/contents/code/main.js.
SECTIONS = [
    ("Halves", [
        ("Left Half", (0, 0, 1 / 2, 1)),
        ("Right Half", (1 / 2, 0, 1 / 2, 1)),
        ("Top Half", (0, 0, 1, 1 / 2)),
        ("Bottom Half", (0, 1 / 2, 1, 1 / 2)),
    ]),
    ("Quarters", [
        ("Top Left Quarter", (0, 0, 1 / 2, 1 / 2)),
        ("Top Right Quarter", (1 / 2, 0, 1 / 2, 1 / 2)),
        ("Bottom Left Quarter", (0, 1 / 2, 1 / 2, 1 / 2)),
        ("Bottom Right Quarter", (1 / 2, 1 / 2, 1 / 2, 1 / 2)),
    ]),
    ("Thirds", [
        ("Left Third", (0, 0, 1 / 3, 1)),
        ("Center Third", (1 / 3, 0, 1 / 3, 1)),
        ("Right Third", (2 / 3, 0, 1 / 3, 1)),
        ("Left Two Thirds", (0, 0, 2 / 3, 1)),
        ("Right Two Thirds", (1 / 3, 0, 2 / 3, 1)),
    ]),
    ("Sixths", [
        ("Top Left Sixth", (0, 0, 1 / 3, 1 / 2)),
        ("Top Center Sixth", (1 / 3, 0, 1 / 3, 1 / 2)),
        ("Top Right Sixth", (2 / 3, 0, 1 / 3, 1 / 2)),
        ("Bottom Left Sixth", (0, 1 / 2, 1 / 3, 1 / 2)),
        ("Bottom Center Sixth", (1 / 3, 1 / 2, 1 / 3, 1 / 2)),
        ("Bottom Right Sixth", (2 / 3, 1 / 2, 1 / 3, 1 / 2)),
    ]),
    ("Other", [
        ("Maximize", (0, 0, 1, 1)),
        ("Center", (1 / 4, 1 / 4, 1 / 2, 1 / 2)),
        ("Restore", "edit-undo"),
        ("Previous Display", "go-previous"),
        ("Next Display", "go-next"),
    ]),
]


def action_id(name):
    return [COMPONENT, PREFIX + name, COMPONENT_NAME, PREFIX + name]


def to_sequence(keys):
    return QKeySequence(QKeyCombination.fromCombined(keys[0])) if keys else QKeySequence()


class Accel:
    """Thin wrapper over the kglobalaccel D-Bus API."""

    def __init__(self):
        bus = dbus.SessionBus()
        self.daemon = dbus.Interface(
            bus.get_object("org.kde.kglobalaccel", "/kglobalaccel"), "org.kde.KGlobalAccel")
        self.component = dbus.Interface(
            bus.get_object("org.kde.kglobalaccel", "/component/" + COMPONENT),
            "org.kde.kglobalaccel.Component")

    def registered(self):
        return {str(n) for n in self.component.shortcutNames() if str(n).startswith(PREFIX)}

    def keys(self, name):
        return [int(k) for k in self.daemon.shortcut(action_id(name)) if int(k)]

    def default_keys(self, name):
        return [int(k) for k in self.daemon.defaultShortcut(action_id(name)) if int(k)]

    def set_keys(self, info_id, keys):
        self.daemon.setForeignShortcut(info_id, dbus.Array(keys, signature="i"))

    def owners(self, key):
        """Actions currently bound to key, as (actionId, description)."""
        result = []
        for info in self.daemon.getGlobalShortcutsByKey(key):
            unique, friendly, comp, comp_friendly = (str(v) for v in info[:4])
            result.append(([comp, unique, comp_friendly, friendly],
                           f"“{friendly}” ({comp_friendly})"))
        return result

    def block(self, blocked):
        self.daemon.blockGlobalShortcuts(blocked)


def layout_icon(spec, palette, size=(44, 28)):
    w, h = size
    pixmap = QPixmap(w * 2, h * 2)
    pixmap.setDevicePixelRatio(2)
    pixmap.fill(Qt.GlobalColor.transparent)
    p = QPainter(pixmap)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    screen = QRectF(1, 1, w - 2, h - 2)
    text = palette.color(QPalette.ColorRole.WindowText)
    frame = QColor(text)
    frame.setAlphaF(0.55)
    p.setPen(frame)
    fill = QColor(text)
    fill.setAlphaF(0.08)
    p.setBrush(fill)
    p.drawRoundedRect(screen, 3, 3)
    if isinstance(spec, tuple):
        x, y, fw, fh = spec
        inner = screen.adjusted(2, 2, -2, -2)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(palette.color(QPalette.ColorRole.Highlight))
        p.drawRoundedRect(QRectF(inner.x() + x * inner.width() + 0.5,
                                 inner.y() + y * inner.height() + 0.5,
                                 fw * inner.width() - 1, fh * inner.height() - 1), 2, 2)
    else:
        icon = QIcon.fromTheme(spec).pixmap(16, 16)
        p.drawPixmap(int((w - 16) / 2), int((h - 16) / 2), icon)
    p.end()
    return pixmap


class ShortcutEdit(QKeySequenceEdit):
    """Records a single key combination; global shortcuts are suspended while
    recording so pressing an existing combo is captured instead of fired."""

    def __init__(self, accel, parent=None):
        super().__init__(parent)
        self.accel = accel
        self.setMaximumSequenceLength(1)
        self.setClearButtonEnabled(True)
        self.setMinimumWidth(170)
        # Only record when clicked, so opening the window doesn't start
        # recording (and suspend global shortcuts) on the first field.
        self.setFocusPolicy(Qt.FocusPolicy.ClickFocus)

    def focusInEvent(self, event):
        self.accel.block(True)
        super().focusInEvent(event)

    def focusOutEvent(self, event):
        self.accel.block(False)
        super().focusOutEvent(event)


class Row:
    def __init__(self, window, name, spec, grid, row):
        self.window = window
        self.name = name
        self.icon = QLabel()
        self.icon.setPixmap(layout_icon(spec, window.palette()))
        self.label = QLabel(name)
        self.edit = ShortcutEdit(window.accel)
        self.edit.editingFinished.connect(self.commit)
        self.edit.keySequenceChanged.connect(self.cleared)
        self.reset = QToolButton()
        self.reset.setIcon(QIcon.fromTheme("edit-reset", QIcon.fromTheme("edit-undo")))
        self.reset.setToolTip("Reset to default")
        self.reset.setAutoRaise(True)
        self.reset.clicked.connect(self.restore_default)
        for col, widget in enumerate((self.icon, self.label, self.edit, self.reset)):
            grid.addWidget(widget, row, col)
        self.current = []

    def load(self, enabled):
        for widget in (self.edit, self.reset, self.label):
            widget.setEnabled(enabled)
        self.current = self.window.accel.keys(self.name) if enabled else []
        self.edit.blockSignals(True)
        self.edit.setKeySequence(to_sequence(self.current))
        self.edit.blockSignals(False)

    def cleared(self, sequence):
        # The clear button empties the field without finishing editing.
        if sequence.isEmpty() and self.current:
            self.window.assign(self, [])

    def commit(self):
        sequence = self.edit.keySequence()
        keys = [sequence[0].toCombined()] if not sequence.isEmpty() else []
        self.edit.clearFocus()
        if keys != self.current:
            self.window.assign(self, keys)

    def restore_default(self):
        self.window.assign(self, self.window.accel.default_keys(self.name))


class SettingsWindow(QWidget):
    def __init__(self, accel):
        super().__init__()
        self.accel = accel
        self.setWindowTitle("TileIt Settings")
        self.setWindowIcon(QIcon.fromTheme("view-split-left-right"))
        self.resize(520, 760)

        outer = QVBoxLayout(self)
        self.banner = QLabel(
            "The TileIt KWin script isn't running, so its shortcuts can't be edited. "
            "Enable it in System Settings → Window Management → KWin Scripts.")
        self.banner.setWordWrap(True)
        self.banner.setStyleSheet("padding: 8px; border-radius: 4px;"
                                  "background: rgba(218, 68, 83, 0.18);")
        outer.addWidget(self.banner)

        body = QWidget()
        column = QVBoxLayout(body)
        self.rows = []
        for title, actions in SECTIONS:
            header = QLabel(title)
            font = header.font()
            font.setBold(True)
            header.setFont(font)
            column.addWidget(header)
            grid = QGridLayout()
            grid.setColumnStretch(1, 1)
            grid.setHorizontalSpacing(12)
            for i, (name, spec) in enumerate(actions):
                self.rows.append(Row(self, name, spec, grid, i))
            column.addLayout(grid)
            line = QFrame()
            line.setFrameShape(QFrame.Shape.HLine)
            line.setFrameShadow(QFrame.Shadow.Sunken)
            column.addWidget(line)

        form = QFormLayout()
        self.gap = QSpinBox()
        self.gap.setRange(0, 200)
        self.gap.setSuffix(" px")
        self.gap.setValue(read_gap())
        self.gap_timer = QTimer(self, singleShot=True, interval=400)
        self.gap_timer.timeout.connect(lambda: write_gap(self.gap.value()))
        self.gap.valueChanged.connect(self.gap_timer.start)
        form.addRow("Gap between windows:", self.gap)
        column.addLayout(form)
        column.addStretch()

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setWidget(body)
        outer.addWidget(scroll)

        buttons = QHBoxLayout()
        defaults = QPushButton(QIcon.fromTheme("edit-reset"), "Restore All Defaults")
        defaults.clicked.connect(self.restore_all)
        close = QPushButton(QIcon.fromTheme("window-close"), "Close")
        close.clicked.connect(self.close)
        buttons.addWidget(defaults)
        buttons.addStretch()
        buttons.addWidget(close)
        outer.addLayout(buttons)

        self.reload()

    def reload(self):
        registered = self.accel.registered()
        self.banner.setVisible(not registered)
        for row in self.rows:
            row.load(PREFIX + row.name in registered)

    def assign(self, row, keys):
        if keys:
            owners = [o for o in self.accel.owners(keys[0])
                      if o[0][:2] != action_id(row.name)[:2]]
            if owners:
                text = to_sequence(keys).toString(QKeySequence.SequenceFormat.NativeText)
                who = "\n".join(desc for _, desc in owners)
                answer = QMessageBox.question(
                    self, "Shortcut in use",
                    f"{text} is already used by:\n{who}\n\nReassign it to “{row.name}”?")
                if answer != QMessageBox.StandardButton.Yes:
                    self.reload()
                    return
                for owner_id, _ in owners:
                    self.accel.set_keys(owner_id, [])
        self.accel.set_keys(action_id(row.name), keys)
        self.reload()

    def restore_all(self):
        for row in self.rows:
            if row.edit.isEnabled():
                self.accel.set_keys(action_id(row.name), self.accel.default_keys(row.name))
        self.reload()

    def closeEvent(self, event):
        if self.gap_timer.isActive():
            self.gap_timer.stop()
            write_gap(self.gap.value())
        super().closeEvent(event)


def read_gap():
    try:
        out = subprocess.run(["kreadconfig6", "--file", "kwinrc", "--group", SCRIPT_GROUP,
                              "--key", "gap", "--default", "0"],
                             capture_output=True, text=True, check=True).stdout
        return int(out.strip() or 0)
    except (OSError, ValueError, subprocess.CalledProcessError):
        return 0


def write_gap(value):
    subprocess.run(["kwriteconfig6", "--file", "kwinrc", "--group", SCRIPT_GROUP,
                    "--key", "gap", str(value)], check=False)
    try:
        bus = dbus.SessionBus()
        dbus.Interface(bus.get_object("org.kde.KWin", "/KWin"), "org.kde.KWin").reconfigure()
    except dbus.DBusException:
        pass


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("tileit-settings")
    app.setApplicationDisplayName("TileIt Settings")
    app.setDesktopFileName("tileit-settings")
    try:
        accel = Accel()
    except dbus.DBusException as error:
        QMessageBox.critical(None, "TileIt Settings",
                             f"Couldn't reach KDE's global shortcut service:\n{error}")
        return 1
    # Never leave global shortcuts blocked, however the app exits.
    app.aboutToQuit.connect(lambda: accel.block(False))
    window = SettingsWindow(accel)
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
